@startuml modelo_casos_uso_mtl
title MyTreeLibrary — modelo de casos de uso\n(ajustado a readme del proyecto e indicaciones de negocio)

skinparam packageStyle rectangle
skinparam actorStyle awesome
left to right direction

actor "Público" as Publico
actor "Colaborador" as Colaborador
actor "ADMIN" as Admin
actor "Sistema\n(MyTreeLibrary)" as Sistema
actor "Proveedor\nde IA" as ProvIA
actor "Servidor\nSMTP" as SMTP

Publico <|-- Colaborador
Colaborador <|-- Admin

rectangle "MyTreeLibrary" #LightBlue {
  usecase "UC-01\nConsultar árboles\npublicados y mapa" as UC1
  usecase "UC-02\nRegistrarse para recibir\nnotificaciones (e-mail)" as UC2

  usecase "UC-03\nRegistrar árbol\n(ficha, fotos, ubicación)" as UC3
  usecase "UC-04\nModificar y eliminar árboles\nregistrados por el usuario" as UC4
  usecase "UC-05\nIdentificar árbol asistido\npor IA (imagen)" as UC5

  usecase "UC-06\nConsultar asistente IA\n(chat conversacional)" as UC6

  usecase "UC-07\nGestionar maestros\ntaxonómicos (familia,\ngénero, especie)" as UC7
  usecase "UC-08\nGestionar solicitudes\nde notificación\n(ACTIVA / CANCELADA)" as UC8

  usecase "UC-09\nNotificar por correo\na suscriptores" as UC9

  usecase "UC-10\nConsultar asistente IA características especie" as UC10
}

' --- Público (sin autenticación) ---
Publico --> UC1
Publico --> UC2

' --- Colaborador (requiere autenticación; hereda Público) ---
Colaborador --> UC3
Colaborador --> UC4
Colaborador --> UC6

UC5 .> UC3 : <<extend>>
UC5 .> UC4 : <<extend>>

note right of UC4
  **COLABORADOR**
  solo fichas propias; **ADMIN**
  cualquier ficha.
end note

' --- ADMIN (requiere autenticación; hereda Colaborador) ---
Admin --> UC7
Admin --> UC8
Admin --> UC10


' --- Notificaciones automáticas (sistema) ---
Sistema --> UC9
UC3 ..> UC9 : <<include>>

UC9 --> SMTP

UC5 --> ProvIA
UC6 --> ProvIA
UC10 --> ProvIA

note right of UC5
  **Próxima versión** (HU-009):
  identificación orientativa
  por imagen.
end note

note right of UC6
  **Próxima versión** (HU-010):
  chat asistido.
end note


@enduml
