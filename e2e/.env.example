# MTL E2E (Playwright) - variables de entorno.
# Copia este fichero a `.env` para la variante "entorno levantado" (local).
# En la variante Docker, estas variables las define docker-compose.e2e.yml.

# URL de la SPA bajo prueba.
#  - Local (vite dev):           http://localhost:5173
#  - Docker (red `mtl`):         http://frontend:80
BASE_URL=http://localhost:5173

# Credenciales del colaborador de prueba (realm `mtl` en local; `mtl-e2e` en Docker).
E2E_USER=colaborador
E2E_PASS=colaborador_dev
